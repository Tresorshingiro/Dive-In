# --- Database -------------------------------------------------------------
# Local PostgreSQL. Replace YOUR_PASSWORD with your postgres user's password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dive_fitness?schema=public"

# Separate database for `npm test` (its name must contain "test"; it is wiped and reseeded)
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dive_fitness_test?schema=public"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# The React app's origin (CORS + cookie checks)
CLIENT_URL=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Require an authenticator app (TOTP) at /admin/login. Off for now; set to true to turn it back on.
ADMIN_MFA_ENABLED=false

# --- Payments (Phase 3) ---------------------------------------------------
# stripe (default) or mock (offline, used by the automated tests)
PAYMENT_PROVIDER=stripe
# Stripe dashboard → Developers → API keys (TEST mode). Never commit a live key.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe` (prints whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...
# Shared secret the mock provider uses to sign webhooks (HMAC-SHA256)
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Mobile Money providers, later:
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_ENV=sandbox
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=

# --- Seed -----------------------------------------------------------------
# Password given to every demo account created by `npm run db:seed`
SEED_DEMO_PASSWORD=DiveDemo2026
