{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev --workspace=client --workspace=shared --include-workspace-root",
  "buildCommand": "npm run build -w client",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dive-in-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://dive-in-api.onrender.com/uploads/:path*" },
    { "source": "/((?!api/|uploads/|assets/|images/|favicon\\.png|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
